<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
    </configSections>
    <startup useLegacyV2RuntimeActivationPolicy="true"> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
	<appSettings>
		<!--<add key="PrinterName" value="BillPrinter"/> --><!--BillPrinter-->
		<add key="PrinterName" value="BillPrinter"/><!--BillPrinter-->
		<add key="LogFilePath" value="D:\\PrintingAppLog\\"/>
		<add key="ReportName" value="ReportFull"/>
		<add key="ReceiptType" value="Receipt"/>
		
		<!-- Receipt Printing Configurations -->
		<add key="FontSize" value="9"/>
		<add key="HeaderFontSize" value="14"/>
		<add key="TitleFontSize" value="11"/>
		<add key="LineSpacing" value="15"/>
		<add key="LogoPath" value="D:\Projects\Majestic\Publish\PrintingApp\logo.jpg"/> <!-- Example: C:\Images\logo.png -->
	  <add key="SrbQrUrlPrefix" value="https://srb.gos.pk/invoice?id=" />
      <add key="PrintReceiptDuplicate" value="true" />
  </appSettings>
