


<input type="hidden" id="hfWaiterId" />
<div class="modal fade" id="addWaiterpopup" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Waiter</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-12">
                        <label for="exampleInputEmail1">Name<span style="color:red">*</span></label>
                        <input type="email" class="form-control alpha" autocomplete="off" id="txtName" placeholder="Name" maxlength="100">
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group">
                            <label>User Name<span style="color:red">*</span></label>
                            <input type="email" class="form-control" autocomplete="off" id="txtUserName" placeholder="User Name" maxlength="20">
                        </div>
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-12">
                        <div class="form-group">
                            <label>Password<span style="color:red">*</span></label>
                            <input type="email" class="form-control" autocomplete="off" id="txtPassword" placeholder="Password" maxlength="20">
                        </div>
                    </div>

                </div>
                <div class="row">
                    <div class="col-md-12">
                        <label for="exampleInputEmail1">Phone</label>
                        <input type="text" class="form-control numeric" autocomplete="off" id="txtPhone" placeholder="Phone No" maxlength="20">
                    </div>
                </div>
                <div class="row">

                    <div class="col-md-12">
                        <label for="exampleInputEmail1">Address</label>
                        <textarea id="txtAddress" class="md-textarea form-control" rows="3"></textarea>
                    </div>

                </div>




                <div class="form-check">
                    <input type="checkbox" class="form-check-input" checked="checked" id="ChkIsWaiterActive">
                    <label class="form-check-label" for="exampleCheck1">Active</label>
                </div>

            </div>

            <div class="card-footer">
                <div class="text-right">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="button" id="btnSaveWaiter" class="btn btn-primary">Submit</button>
                </div>
            </div>




        </div>
    </div>
</div>

