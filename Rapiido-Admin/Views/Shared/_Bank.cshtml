

<input type="hidden" id="hfBankId" />
<div class="modal fade" id="addBankpopup" data-backdrop="static" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h4 class="modal-title">Bank</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-12">
                        <label for="exampleInputBankAmount">Bank</label>
                        <input type="text" class="form-control" id="txtBankName" placeholder="Bank" maxlength="100">
                    </div>
                </div>
               <div class="row">
                    <div class="col-12">
                        <label for="exampleInputBankAmount">Amount</label>
                        <input type="number" class="form-control" id="txtBankAmount" placeholder="Bank Amount" maxlength="100">
                    </div>
                </div>

                <div class="form-check">
                    <input type="checkbox" class="form-check-input" checked="checked" id="ChkIsBank">
                    <label class="form-check-label" for="exampleCheck1">Is Bank</label>
                </div>
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" checked="checked" id="ChkIsBankActive">
                    <label class="form-check-label" for="exampleCheck1">Active</label>
                </div>

            </div>

            <div class="card-footer">
                <div class="text-right">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="button" id="btnSaveBank" class="btn btn-primary">Submit</button>
                </div>
            </div>
        </div>
    </div>
</div>

