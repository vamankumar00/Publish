@{
    ViewBag.Title = "FlightDetails";
}

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.4.1/js/bootstrap-datepicker.min.js"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.4.1/css/bootstrap-datepicker3.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.1/xlsx.full.min.js"></script>

<script src="~/CustomJquery/DefaultClientId.js?dt=@(DateTime.Now.Ticks)"></script>
<script src="~/CustomJquery/GenericAjax.js?dt=@(DateTime.Now.Ticks)"></script>
<script src="~/CustomJquery/FlightDetails.js?dt=@(DateTime.Now.Ticks)"></script>


<style>
    tr.highlighted td {
        background: #fdfd96;
    }

    .checked {
        color: orange;
    }

    .blink {
        animation: blinker 2s linear infinite;
    }

    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }
</style>
<div class="mid-container-wrapper">
    <div class="container-fluid no-pad">
        <div class="row no-pad">

            <div class="col-md-12">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Customers Detail
                    </div>
                    <div class="panel-body dt-height">
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="row">
                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">From Date :</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-calendar">
                                                    </i>
                                                </div>
                                                <input class="form-control" id="FlightfromDate" name="date" placeholder="YYYY-MM-DD" type="text">
                                            </div>
                                        </form>
                                    </div>

                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">To Date :</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-calendar">
                                                    </i>
                                                </div>
                                                <input class="form-control" id="FlighttoDate" name="date" placeholder="YYYY-MM-DD" type="text">
                                            </div>
                                        </form>
                                    </div>


                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">Bank</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-desktop">
                                                    </i>
                                                </div>
                                                <select name="ddlBank_Card" id="ddlBank_Card" class="form-control">
                                                    <option value=''>Select</option>
                                                </select>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">Payment Type</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-desktop">
                                                    </i>
                                                </div>
                                                <select name="ddlPaymentType" id="ddlPaymentType" class="form-control">
                                                    <option value=''>Select</option>
                                                    <option value='CARD'>CARD</option>
                                                    <option value='WALKIN'>WALK-IN</option>
                                                    <option value='AIRLINE'>AIRLINE</option>
                                                </select>
                                            </div>
                                        </form>
                                    </div>

                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">Payment By</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-desktop">
                                                    </i>
                                                </div>
                                                <select name="" id="ddlPaymentBy" class="form-control">
                                                    <option value=''>Select</option>
                                                    <option value="CARD">Card</option>
                                                    <option value="CASH">Cash</option>
                                                    <option value='CARD/CASH'>CARD + CASH</option>
                                                </select>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">Fast Track Payment</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-desktop">
                                                    </i>
                                                </div>
                                                <select name="ddlFTPayment" id="ddlFTPayment" class="form-control">
                                                    <option value=''>Select</option>
                                                    <option value='1'>Yes</option>
                                                    <option value='0'>No</option>
                                                </select>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">Flight No:</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-hourglass-2">
                                                    </i>
                                                </div>
                                                <input class="form-control" id="FlightNo" name="FlightNo" type="text">
                                            </div>
                                        </form>
                                    </div>
                                    <div class="col-sm-2">
                                        <!-- Form code begins -->
                                        <form method="post">
                                            <label for="">Bin No:</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-hourglass-2">
                                                    </i>
                                                </div>
                                                <input class="form-control" id="BinNo" name="BinNo" type="text">
                                            </div>
                                        </form>
                                    </div>

                                    <div class="col-sm-2">
                                        <label for=""></label>
                                        <div class="input-group">
                                            <button type="button" id="GenerateFlightReport" class="btn btn-primary">Search</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="tbl-container tbl-product">
                            <!-- Table -->
                            <input type="hidden" id="HFFlightDetailsMasterId" />
                            <div class="col-md-3">
                                <label for="pageSizeSelector">Page Size:</label>
                                <select id="pageSizeSelector" onchange="ChangePageSize()" class="form-control d-inline-block w-auto mx-2">
                                    <option value="100" selected>100</option>
                                    <option value="500">500</option>
                                    <option value="1000">1000</option>
                                </select>
                                <div id="recordSummary" class="mb-2 font-weight-bold text-info"></div>
                            </div>
                            <button class="btn-success btn-sm pull-right" id="exportExcelBtn">Export to Excel</button>

                            <table class="table table-bordered" id="FlightDetails_table" style="width:100%">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Id</th>
                                        <th>Created Date</th>
                                        <th>LOC</th>
                                        <th>Bank Name</th>
                                        <th>Card Product</th>
                                        <th>Flight No</th>
                                        <th>Bin No</th>
                                        <th>Passenger Name</th>
                                        <th>Guest Name</th>
                                        <th>No of Guests</th>
                                        <th>No of Meals</th>
                                        <th>Children</th>
                                        <th>GRO</th>
                                        <th>Airline</th>
                                        <th>Auth No</th>
                                        <th>Order Id</th>
                                        <th>Scan</th>
                                        <th>Scan Date</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                            </table>

                        </div>
                        <div id="paginationControls" class="mt-3"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@*Flight Customer Order Modal*@
<div class="modal fade" id="ViewFlightOrder" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 class="modal-title" id="exampleModalLongTitle">
                    Flight Customer Order
                    <span class="ordernoFD pull-right"></span>
                    <label class="pull-right" for="ordernoFD">Order No:</label>
                </h3>
            </div>
            <div class="modal-body">
                <div class="tbl-container tbl-product">
                    <!-- Table -->
                    <table class="table" id="tblCustomerOrder">
                        <thead class="thead-dark">
                            <tr>
                                <th>Entry Date</th>
                                <th>Order Date</th>
                                <th>Item</th>
                                <th>Qty</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        var date_input = $('input[name="date"]'); //our date input has the name "date"
        var container = $('.bootstrap-iso form').length > 0 ? $('.bootstrap-iso form').parent() : "body";
        date_input.datepicker({
            format: 'yyyy-mm-dd',
            container: container,
            todayHighlight: true,
            autoclose: true,
        })
    })
</script>