<style>
    tr.highlighted td {
        background: #fdfd96;
    }

    .checked {
        color: orange;
    }

    .blink {
        animation: blinker 2s linear infinite;
    }

    #reportTableHeader th {
        position: sticky;
        top: 0; /* Sticks the header to the top */
        z-index: 2; /* Ensure the header stays above the table content */
        background-color: #343a40; /* Dark background to match your header */
        color: white;
    }

    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }


    .TotalEntries {
        font-weight: bold;
        margin-right: 10px;
        margin-left: 5px;
    }

    .total-row {
        font-weight: bold;
        background-color: #f5f5f5; /* Light gray background for the total row */
        border: solid thin black;
    }

    .rating-stars {
        font-size: 18px;
        color: gold;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.6);
        display: none;
        justify-content: center;
        align-items: center;
        z-index: 9999;
    }

        .modal-overlay.active {
            display: flex;
        }

    .modal-content {
        background-color: #fff;
        padding: 20px;
        border-radius: 8px;
        max-height: 90vh;
        overflow-y: auto;
        width: 80vw; /* Increase width to 80% of viewport */
        max-width: 1000px; /* Optional max width */
        box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

        .modal-content button {
            margin-top: 20px;
            padding: 8px 16px;
            background: #007bff;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

            .modal-content button:hover {
                background: #0056b3;
            }

    .feedback-preview {
        color: blue;
        text-decoration: underline;
        cursor: pointer;
    }

        .feedback-preview:hover {
            text-decoration: underline;
            color: darkblue;
        }

    .modal-content table {
        width: 100%;
        border-collapse: collapse;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        margin-top: 15px;
    }

    .modal-content th, .modal-content td {
        border: 1px solid #dee2e6;
        padding: 10px 12px;
        text-align: left;
    }

    .modal-content thead {
        background-color: #f8f9fa;
        color: #343a40;
        font-weight: bold;
    }

    .modal-content tr:nth-child(even) {
        background-color: #f2f2f2;
    }

    .modal-content tr:hover {
        background-color: #e9ecef;
    }

    #pagination button {
        margin: 0 3px;
        padding: 6px 12px;
        border: 1px solid #007bff;
        background-color: white;
        color: #007bff;
        border-radius: 4px;
        cursor: pointer;
    }

        #pagination button:disabled {
            background-color: #007bff;
            color: white;
            cursor: default;
        }

    #DownloadPdfBtn:hover {
        background-color: #a00a33;
        color: #fff;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        transform: scale(1.05);
        transition: all 0.3s ease;
    }

    #DownloadExcelBtn {
        background-color: #1D6F42;
        color: #fff;
        border: none;
        border-radius: 4px;
        padding: 6px 14px;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    #DownloadExcelBtn:hover {
        background-color: #155233;
        box-shadow: 0 4px 8px rgba(0,0,0,0.2);
        transform: scale(1.05);
    }
</style>
