
@{
    ViewBag.Title = "Driver";
}
<script src="~/CustomJquery/GenericAjax.js?dt=@(DateTime.Now.Ticks)"></script>
<script src="~/CustomJquery/Driver.js?dt=@(DateTime.Now.Ticks)"></script>
<div class="mid-container-wrapper">
    <div class="container-fluid no-pad">
        <div class="row no-pad">
            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading">Driver Information</div>
                    <div class="panel-body">
                        <form>
                            <div class="row">

                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="exampleInputEmail1">Driver Name</label>
                                                <input type="text" id="txtDriverName" class="form-control" required="">
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="exampleInputEmail1">Vehicle Numer</label>
                                                <input type="text" id="txtVehicleNumer" class="form-control" required="">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="fname">User Name</label>
                                                <input type="text" id="txtUserName" class="form-control" required="">
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="lname">Password</label>
                                                <input type="password" id="txtDriverPassword" class="form-control" required="">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="exampleInputEmail1">CNIC</label>
                                                <input type="text" id="txtCNIC" class="form-control" required="">
                                            </div>
                                        </div>
                                        <div class="col-sm-6">
                                            <div class="form-group">
                                                <label for="lname">Cell No</label>
                                                <input type="text" id="txtCellNo" class="form-control" required="">
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="form-group">
                                                <label for="exampleInputEmail1">Address</label>
                                                <input type='text' class="form-control" id='txtDriverAddress' />

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <button type="button" id="AddDriver" class="btn btn-primary">Submit</button>
                            <button type="button" id="ClearDriver" class="btn btn-default">Clear</button>
                            @*<button type="button" title="Delete" class="btn btn-default btn-secondary"><i class="fa fa-window-close"></i> </button>*@
                        </form>
                    </div>
                </div>
                <div class="alert alert-success" id="Alert" hidden role="alert">

                </div>
            </div>
                <div class="col-md-6">
                    <div class="panel panel-default">
                        <div class="panel-heading">Detail</div>
                        <div class="panel-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <input type="text" id="txtDriverSearch" class="form-control" placeholder="Search Driver">
                                </div>
                            </div>
                            <div class="tbl-container tbl-product">
                                <!-- Table -->

                                <table class="table" id="Driverlist_table" style="width:100%">
                                    <thead class="thead-dark">
                                        <tr>
                                            <th>Name</th>
                                            <th>UserName</th>
                                            <th>Password</th>
                                            <th>NIC</th>
                                            <th>CellNo</th>
                                            <th>DriverNo</th>
                                            @*<th style="width:20%" scope="col">image</th>*@
                                            @*<th style="width:20%" scope="col" class="text-right">Action</th>*@
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </div>
</div>

