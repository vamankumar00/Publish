<style>
    .call-waiter {
        color: #a3e4b2; /* soft green (light) before hover */
        font-size: 22px;
        cursor: pointer;
        margin-left: 12px;
        transition: 0.25s ease;
    }

    .call-waiter:hover {
        color: #28a745; /* stronger green on hover */
        transform: scale(1.2);
        text-shadow: 0 0 8px rgba(40, 167, 69, 0.8); /* green glow */
    }


</style>

<div class="mid-container-wrapper">
    <div class="container-fluid no-pad">
        <div class="row no-pad">
            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading">
                        Categories
                        <span style="float:right">Total Sales <label id="lblTotalSales"></label></span>
                    </div>
                    <div class="panel-body">
                        <form>
                            <div class="row">

                                <div class="col-md-12">
                                    <div class="row">
                                        <div class="col-lg-12">
                                            <div class="input-group">
                                                <input type="text" id="SearchCatItem" class="form-control" placeholder="Search for...">
                                                <span class="input-group-btn">

                                                    <button class="btn btn-default" id="btnSearchCatItem" type="button"><i class="fa fa-search"></i></button>
                                                </span>
                                            </div><!-- /input-group -->
                                            <br />
                                        </div><!-- /.col-lg-6 -->
                                    </div><!-- /.row -->
                                    <div class="cate-item-container">
                                        <div class="row" id="DineinCategory">
                                            @*<div class="col-xs-6 col-md-3">
                                                    <div class="thumbnail">
                                                        <img src="~/images/6_BBQNamkeen.jpeg" alt="...">
                                                    </div>
                                                </div>
                                                <div class="col-xs-6 col-md-3">
                                                    <div class="thumbnail">
                                                        <img src="~/images/6_BBQNamkeen.jpeg" alt="...">
                                                    </div>
                                                </div>
                                                <div class="col-xs-6 col-md-3">
                                                    <div class="thumbnail">
                                                        <img src="~/images/6_BBQNamkeen.jpeg" alt="...">
                                                    </div>
                                                </div>
                                                <div class="col-xs-6 col-md-3">
                                                    <div class="thumbnail">
                                                        <img src="~/images/6_BBQNamkeen.jpeg" alt="...">
                                                    </div>
                                                </div>*@
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-sm-12">
                                            <div class="panel panel-default bg-none">
                                                <div class="panel-heading"><h3>Product</h3></div>
                                                <div class="panel-body dinein-product">
                                                    <div class="row" id="DineinItems">

                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            @*<button type="button" id="#" class="btn btn-primary">Submit</button>
                                <button type="button" id="#" class="btn btn-default">Clear</button>*@
                            @*<button type="button" title="Delete" class="btn btn-default btn-secondary"><i class="fa fa-window-close"></i> </button>*@
                        </form>
                    </div>
                </div>
                <div class="alert alert-success" id="Alert" hidden role="alert">

                </div>
            </div>
            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading">

                        <div class="form-group row">
                            <div class="col-sm-3">
                                <label for="ddlDineInTables" class="col-form-label">Table</label>
                            </div>
                            <div class="col-sm-3">
                                <label for="ddlOrderType" class="col-form-label">Order Type</label>
                            </div>
                            <div class="col-sm-3">
                                <label for="ddlWaiter" class="col-form-label">Waiter</label>
                            </div>
                            <div class="col-sm-3">
                                <label for="txtCustName" class="col-form-label">Name/Comments</label>
                            </div>
                        </div>

                        <div class="form-group row">

                            <div class="col-sm-3">
                                <select name="ddlDineInTables" id="ddlDineInTables" class="form-control">
                                </select>
                            </div>
                            @*<div class="col-2">
                TakeAway<input type="checkbox" id="chkTakeaway" value="6" style="margin-left:10px;" />
            </div>*@
                            <div class="col-sm-3">
                                <select name="ddlOrderType" id="ddlOrderType" class="form-control" placeholder="Select Order Type">
                                    @*<option value="0">Select Order Type...</option>*@
                                    @*<option value="4">On Call</option>*@
                                    @*<option value="5">Dine-In</option>*@
                                    @*<option value="6">Takeaway</option>*@
                                    @*<option value="11">FOC</option>*@
                                    @*<option value="8">Entertainment</option>*@
                                    @*<option value="9">Staff</option>*@
                                    @*<option value="10">Party</option>*@
                                    @*<option value="12">Delivery</option>*@
                                    @*<option value="13">FoodPanda</option>*@
                                </select>
                            </div>
                            <div class="col-sm-3">
                                <select name="ddlWaiter" id="ddlWaiter" class="form-control">
                                </select><div id="waiterStatus" style="margin-top: 5px;"></div>
                            </div>
                            <div class="col-sm-3">
                                <input type='text' class="form-control" id='txtCustName' name="txtCustName" placeholder="Enter Name..." />
                            </div>
                        </div>

                        <div class="form-group row d-flex justify-content-end align-items-center" id="departmentContainer">
                            <div class="col-sm-3">
                                <label for="ddlDepartment" class="col-form-label">Department</label>
                                <select name="ddlDepartment" id="ddlDepartment" class="form-control mt-1">
                                    <option value="0">Select Department...</option>
                                    <option value="1">Sales</option>
                                    <option value="2">HR</option>
                                    <option value="3">Finance</option>
                                    <option value="4">IT</option>
                                </select>
                            </div>
                            <div class="col-sm-3" id="ReferenceNameContainer" style="display:none;">
                                <label for="txtReferenceName" class="col-form-label">Reference Name</label>
                                <input type='text' class="form-control mt-1" id='txtReferenceName' name="txtReferenceName" placeholder="Enter Reference Name..." />
                            </div>
                        </div>

                    </div>
                    <div class="panel-body cate-page-height">
                        <div class="row">
                            <div class="col-sm-6">
                                <div class="dinein-btn radio-btn" style="display:none;">
                                    <div class="radio-box">
                                        <input type="radio" name="optradio" checked value="5"><label class="radio-inline">Dine-Inn</label>
                                    </div>
                                    <div class="radio-box">
                                        <input type="radio" name="optradio" value="6"><label class="radio-inline">Takeaway</label>
                                    </div>
                                    <div class="radio-box">
                                        <input type="radio" name="optradio" value="1"><label class="radio-inline">Delivery</label>
                                    </div>

                                </div>
                            </div>
                            @*<div class="col-sm-6">
                                    <input type="text" id="#" class="form-control" placeholder="Search Driver">
                                </div>*@
                        </div>
                        <div class="tbl-container tbl-product item-tbl">
                            <!-- Table -->

                            <table class="table" id="tbl_Product" style="width:100%">
                                <thead class="thead-dark">
                                    <tr>
                                        <th style="width:44%">Item</th>
                                        <th width="20px"></th>
                                        <th width="20px" style="text-align:center">QTY</th>
                                        <th width="40px"></th>
                                        <th>Rate</th>
                                        <th>Amount</th>
                                        <th style="width:5%" scope="col" class="text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="AdditionalAmount"></td>
                                        <td class="AdditionalAmountVal"></td>
                                        <td></td>
                                        <td></td>
                                        <td>Total</td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="panel panel-default">
                    <div class="panel-heading">Action</div>
                    <div class="panel-body cate-page-height action">
                        <div class="row">
                            <input type="hidden" id="DineinTaxAmount" />
                            <input type="hidden" id="DineinDiscountAmount" />
                            <div class="col-md-4">
                                <label>Tax</label>
                                <select class="form-control" id="DineinTax">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Discount</label>
                                <select class="form-control" id="DineinDiscount">
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label>Net Total Amount</label>
                                <input type="text" id="dinein_NetAmount" value="" class="form-control" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-12 text-right">
                                <br />
                                <button id="bttnResetDinein" class="btn btn-primary">Clear</button>
                                @*<button id="bttnCancelDinein" class="btn btn-primary">Cancel</button>*@
                                <button id="bttnHoldDinein" class="btn btn-primary">Hold</button>
                                <button id="bttnUnHoldDinein" class="btn btn-primary">Unhold</button>
                                @*<button id="bttnSubmitDinein" class="btn btn-primary">submit</button>*@
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
@Html.Partial("_SavePopup")
@Html.Partial("_HoldOrderList")
@Html.Partial("_AdditonalDetailItems")
@Html.Partial("_Delivery")
