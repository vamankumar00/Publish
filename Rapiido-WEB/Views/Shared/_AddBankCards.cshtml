<div class="modal fade" id="AddCardsModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close col-xs-offset-1" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                    <h3 class="modal-title" id="exampleModalLongTitle">
                        Add More Cards
                    </h3>
                
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Passenger Name</label>
                                        <input type="text" class="form-control" id="txtPassengerName" placeholder="Enter Passenger Name">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        @*<input type="hidden" id="OrderId" />*@
                                        <label for="ddlBank_Card_AB">Bank Card</label>
                                        <select name="ddlBank_Card_AB" id="ddlBank_Card_AB" class="form-control">
                                            <option value=''>Select</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label for="Bin_No_AB">BIN No.</label>
                                        <input type="text" class="form-control" id="Bin_No_AB" maxlength="11" placeholder="123456-3456">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label for="ddlCardType_AB">Card Type</label>
                                        <select name="ddlCardType_AB" id="ddlCardType_AB" class="form-control">
                                            <option value=''>Select</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label for="ddlCardProduct_AB">Card Product</label>
                                        <select name="ddlCardProduct_AB" id="ddlCardProduct_AB" class="form-control">
                                            <option value=''>Select</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>


                    <button type="button" id="SubmitCards" class="btn btn-primary">Submit</button>


                </form>

            </div>
        </div>
    </div>
</div>

