<div class="modal fade" id="ViewDenomination" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h3 class="modal-title" id="exampleModalLongTitle">Shift Close</h3>
            </div>
            <div class="modal-body">
                <label>Select Shift</label>
                <select name="ddlShift" id="ddlShift" class="form-control">
                    @*<option value="">Select</option>
                    <option value="1">Shift A</option>
                    <option value="2">Shift B</option>*@
                </select>
                <div class="tbl-container tbl-product">
                    <!-- Table -->
                    <table class="table" id="tblDenomination">
                        <thead class="thead-dark">
                            <tr>
                                <th>Money Denomination</th>
                                <th> </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <label for="denomination5000">5000:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination5000" name="denomination5000" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination1000">1000:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination1000" name="denomination1000" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination500">500:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination500" name="denomination500" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination100">100:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination100" name="denomination100" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination50">50:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination50" name="denomination50" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination20">20:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination20" name="denomination20" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination10">10:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination10" name="denomination10" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination5">5:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination5" name="denomination5" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination2">2:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination2" name="denomination2" placeholder="0">
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <label for="denomination1">1:</label>
                                </td>
                                <td>
                                    <input type="number" id="denomination1" name="denomination1" placeholder="0">
                                </td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td id="">Total: </td>
                                <td id="total"> 0</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" id="SubmitDenomination" class="btn btn-primary">Save changes</button>
            </div>
        </div>
    </div>
</div>
<script src="~/CustomJquery/ShiftDenomination.js?dt=@(DateTime.Now.Ticks)"></script>

