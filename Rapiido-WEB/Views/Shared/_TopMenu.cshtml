<script>
    $(document).ready(function () {
        $("#txtRestaurantName").text($("#SessionRestaurantName").val());
        $(".UserName").text($("#SessionUserName").val());
        $('#lidd').hide();
        var isManager = window.localStorage.getItem("ISBackOffice");
        var clientId = DefaultClientId.toUpperCase();

        var lst = "";
        $("#ulnav").html("");

        lst = "";
        if (isManager != 1) {
            lst += "<li class=''><a href='../Dinein/Dinein'><i class='glyphicon glyphicon-home'></i> Dashboard  <span class='sr-only'>(current)</span></a></li>";
            lst += "<li><a href='../Order/OrderList'><i class='fa fa-address-card'></i> Order Detail</a></li>";
            lst += "<li><a href='../Product/Product'><i class='fa fa-server'></i> Product</a></li>";
        }

        if (isManager == 1 && clientId == 'KF_987')
        {
            lst += "<li><a href='../Inventory/Recipe'><i class='fa fa-server'></i> Recipe</a></li>";
            lst += "<li><a href='../Inventory/Consumption'><i class='fa fa-server'></i> Consumption Report</a></li>";
        }

        //South City
        if (clientId == 'SC_101') {
            lst += "<li><a href='../Inventory/FinancialReport'><i class='fa fa-server'></i> Financial Report</a></li> ";
        }

        //Sky Majestic
        if (isManager == 1 && (clientId == 'MJ_100_I' || clientId == 'SM_100' || clientId == 'MJ_100' || clientId == 'SM_100_I' || clientId == 'MJ_100_I' || clientId == 'CM_100_I')) {
            lst += "<li><a href='../Home/Payment'><i class='fa fa-server'></i> Payment</a></li> ";
            lst += "<li><a href='../Inventory/FlightDetails'><i class='fa fa-server'></i> Flight Details Report</a></li> ";
            $('#lidd').show();
        }

        //Cafe Majestic
        //if (clientId == 'CM_100_I') {
        //    lst += "<li><a href='../Inventory/FinancialReport'><i class='fa fa-server'></i> Financial Report</a></li> ";
        //    lst += "<li><a href='../Inventory/ItemSaleReport'><i class='fa fa-server'></i> Item Sale Report</a></li> ";
        //    lst += "<li><a href='../Inventory/Reports'><i class='fa fa-server'></i> Other Report</a></li> ";
        //}

         $('#ulnav').append(lst);


        $(".menu li a").each(function () {
            var isActive = this.pathname === location.pathname;
            $(this).parent().toggleClass('active', isActive);
        });
        $('#lilogout').click(function () {
               
            var request = {};
            request.DefaultClientId = DefaultClientId;
            request.UserId = window.localStorage.getItem("UserId"); //sessionStorage.UserId;
            Common.Ajax('POST', url + 'LogoutWeb', JSON.stringify(request), 'json', LogoutHandler);
        });
    });

    function LogoutHandler(response) {

        Common.Ajax('POST', '../Home/Logout', '', 'json', LogoutWebHandler);

    }
    function LogoutWebHandler(response) {

        if (response == "success") {
            window.localStorage.clear();
            window.location = "../Login/Login";
        }
    }
    function closeshift() {
        $('#ViewDenomination').modal('show');

    }
    //$(".menu li a").on('click', function (e) {
    //    $(".menu .active").removeClass('active');
    //    $(this).parent().addClass('active');
    //    e.preventDefault();
    //});
    setInterval(function () {
        //UpdateNotifications();

        var request = {};
        request.DefaultClientId = DefaultClientId;
        Common.Ajax('POST', url + 'GetNotifications', JSON.stringify(request), 'json', UpdateNotifications);
    }, 15000);

    function UpdateNotifications(response) {
        if (response != null) {

            var j = ""; var p = 0; var Q = "";
            $.each(response, function (k, v) {
                p++;
                if (p < 6) {
                    j += "<li><a><strong>  " + v.Notification + " </strong> <br /> <div style='text-align:right;font-size:smaller;font-style:italic'> <i style='font-size:smaller'> updated : " + v.LastUpdated + "</i></div></a></li>";
                }
                Q += "<strong>  " + v.Notification + " </strong><br /><div class='pull-right'><i class='fa fa-check btn btn-success btnnotaccept ' onclick='showDetails(this)' data-type='Approved' data-orderid=" + v.OrderId + " data-orderno=" + v.OrderNo + " data-itemid=" + v.ItemId + " data-itemqty=" + v.ItemQty + " data-itemdesc= '" + v.ItemDesc + "' data-orderdetailselfid=" + v.OrderDetailSelfId + " ></i><i class='fa fa-trash btn btn-danger btnnotreject ' onclick='showDetails(this)' data-type = 'Rejected' data-orderid=" + v.OrderId + " data-orderno=" + v.OrderNo + " data-itemid=" + v.ItemId + " data-itemqty=" + v.ItemQty + " data-itemdesc= '" + v.ItemDesc + "' data-orderdetailselfid=" + v.OrderDetailSelfId + "></i></div> <br /> <div style='text-align:right;font-size:smaller;font-style:italic'> <i style='font-size:smaller'> updated : " + v.LastUpdated + "</i></div>";
            });
            $('#myNotifyList').html("");
            j += "<li><a data-toggle='modal' data-target='#NotificationListModal'><div style='text-align:center'><strong> Show more </strong></div></li>";
            $('#myNotifyList').append(j);
            $('#countNotify').html("<span>" + p + "</span>");
            $('#myAllNotifications').html("");
            $('#myAllNotifications').append(Q);
            //if (p > 0) {
            //    $("#Notification").addClass("blink");
            //}
            //else {
            //    $("#Notification").removeClass("blink");
            //}
            if (p > 0) {
                $("#Notification").addClass("blink");
                $("#notificationDot").show();
            } else {
                $("#Notification").removeClass("blink");
                $("#notificationDot").hide();
            }


        }
    }
    function showDetails(req) {
        $(this).prop('disabled', true);
        let requestType = req.getAttribute("data-type");
        var reason = "";
        debugger;
        var request = {};
        request.DefaultClientId = DefaultClientId;
        request.ItemStatus = requestType;
        request.OrderId = req.getAttribute("data-orderid");
        request.OrderNo = req.getAttribute("data-orderno");
        request.ItemId = req.getAttribute("data-itemid");
        request.ItemQty = req.getAttribute("data-itemqty");
        request.ItemDesc = req.getAttribute("data-itemdesc");
        request.OrderDetailSelfId = req.getAttribute("data-orderdetailselfid");
        request.UpdatedBy = window.localStorage.getItem("UserId"); //sessionStorage.UserId;
        request.IsOffline = 1;

        if (requestType == "Rejected") {
            $('#customAlertModal').modal('show');

            $('#selectOption').click(function () {
                var selectedOption = $('#ddlRejectReason').val();

                reason = selectedOption;
                request.RejectReason = reason;
                Common.Ajax('POST', url + 'UpdateItemDeleteRequest', JSON.stringify(request), 'json', UpdateItemDeleteRequestHandler);

                $('#customAlertModal').modal('hide');
                return true;
            });
        }
        else {
            request.RejectReason = reason;
            Common.Ajax('POST', url + 'UpdateItemDeleteRequest', JSON.stringify(request), 'json', UpdateItemDeleteRequestHandler);
        }
    }
    function UpdateItemDeleteRequestHandler(response) {
        GetOrderListReport();
        if (response == "success") {
            GetOrderListReport();
            return true;
        }
    }

</script>
