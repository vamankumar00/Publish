<style>
    .blink {
        animation: blinker 2s linear infinite;
    }

    @@keyframes blinker {
        50% {
            opacity: 0;
        }
    }
    /* Make notification link bold and red */
.notification-link {
    font-weight: bold;
    position: relative;
}

/* Notification dot */
.notification-dot {
    position: absolute;
    top: 5px;
    right: 19px;
    height: 14px;
    width: 14px;
    background-color: red;
    border-radius: 50%;
    display: none;
    animation: blinkDot 2s infinite;
}

/* Blink animation */
@@keyframes blinkDot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
}

</style>
