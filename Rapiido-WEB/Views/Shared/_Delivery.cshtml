<!-- Modal for Delivery Details -->
<div class="modal fade" id="deliveryModal" tabindex="-1" role="dialog" aria-labelledby="deliveryModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deliveryModalLabel">Delivery Details</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form action="Post" id="deliveryForm">
                    <div class="form-group">
                        <h3 id="txtOrderType"></h3>
                    </div>
                    <div class="form-group">
                        <label for="txtName">Name</label>
                        <input type="text" class="form-control" id="txtName" placeholder="Enter Name" required>
                    </div>
                    <div class="form-group">
                        <label for="txtAddress">Address</label>
                        <input type="text" class="form-control" id="txtAddress" placeholder="Enter Address" required>
                    </div>
                    <div class="form-group">
                        <label for="txtContactNumber">Contact Number</label>
                        <input type="number" class="form-control" id="txtContactNumber" placeholder="Enter Contact Number" required>
                    </div>
                    <div class="form-group">
                        <label for="txtRemarks">Special Instructions/Request</label>
                        <textarea class="form-control" id="txtRemarks" placeholder="Enter Remarks or Special Request"></textarea>
                    </div>
                    <div class="form-group" id="deliveryChargesGroup">
                        <label for="txtDeliveryCharges">Delivery Charges</label>
                        <input type="number" class="form-control" id="txtDeliveryCharges" placeholder="Enter Delivery Charges">
                    </div>
                    <div class="form-group" id="invoiceNoGroup" style="display: none;">
                        <label for="txtInvoiceNo">Invoice No#</label>
                        <input type="text" class="form-control" id="txtInvoiceNo" placeholder="Enter Invoice No#" required>
                    </div>
                    <div class="form-group">
                        <label for="ddlRiders">Select Rider</label>
                        <select class="form-control" id="ddlRiders">
                            <option value="">Select Rider</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" id="btnSaveDeliveryDetails">Save Details</button>
            </div>
        </div>
    </div>
</div>
