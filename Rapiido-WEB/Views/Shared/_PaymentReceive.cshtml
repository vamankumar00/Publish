<div class="modal fade" id="ViewPaymentReceive" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close col-xs-offset-1" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                    <h3 class="modal-title" id="exampleModalLongTitle">
                        Receive Payment
                        <span class="orderno pull-right"></span><label class="pull-right" for="orderno">Order No:</label>
                    </h3>
                
            </div>
            <div class="modal-body">
                <form>
                    <div class="row">
                        <div class="col-lg-12">
                            <div class="row">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <input type="hidden" id="OrderId" />
                                        <label for="ddlPaymentType">Payment Type</label>
                                        <select name="" id="ddlPaymentType" class="form-control">
                                            <option value='CARD'>CARD</option>
                                            <option value='CASH'>CASH</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row BankDetails" style="display: none;">
                                <div class="col-sm-12">
                                    <div class="form-group">
                                        <label for="ddlBank">Bank Card</label>
                                        <select name="" id="ddlBank" class="form-control">
                                        </select>
                                    </div>
                                </div>
                                @*<div class="col-sm-6">
                                    <div class="form-group">
                                        <label for="ddlCardType">Card Type</label>
                                        <select name="" id="ddlCardType" class="form-control">
                                            <option value=''>Select</option>
                                        </select>
                                    </div>
                                </div>*@
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <input type="hidden" id="hfTaxPer" />
                                        <input type="hidden" id="hfDiscountPer" />
                                        <input type="hidden" id="hfDiscountAmount" />
                                        <input type="hidden" id="hfOrderStatus" />
                                        <label for="txtOrderAmount">Order Amount</label>
                                        <input type='text' class="form-control" id='txtOrderAmount' readonly="readonly" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        <label for="txtNetAmount">Net Amount</label>
                                        <input type='text' class="form-control" id='txtNetAmount' readonly="readonly" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Amount Received</label>
                                        <input type='text' class="form-control" id='txtRecamt' />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Remarks</label>
                                        <textarea rows="4" cols="50" class="form-control" id='txtRemarks'></textarea>
                                        @*<input type='text' class="form-control" id='txtRemarks' />*@

                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>


                    <button type="button" id="SubmitPayment" class="btn btn-primary">Submit</button>


                </form>

            </div>
        </div>
    </div>
</div>

