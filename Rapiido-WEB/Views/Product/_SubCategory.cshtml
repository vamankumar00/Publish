<div class="mid-container-wrapper">
    <div class="container-fluid no-pad">
        <div class="row">
            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading">Subcategory Information</div>
                    <div class="panel-body prd-tbl">
                        <form>
                            <input type="hidden" id="Subscategory_CategoryId" />
                            <input type="hidden" id="Subscategory_SubscategoryId" />
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Catagory</label>
                                        <select name="" id="ddlCategory0" class="form-control">
                                            <option value=''>Select</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Sub Category</label>
                                        <input type="text" class="form-control" id="txt_subcategory" required placeholder="Sub Category">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Short Description</label>
                                        <input type="text" class="form-control" id="txtShortDescriptionSubCategory" placeholder="Short Description">
                                        <input class="form-check-input" type="checkbox" checked value="" id="chkSubCategory" required>
                                        <label class="form-check-label" for="invalidCheck2">
                                            Is Active
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Sort Order</label>
                                        <input type='text' class="form-control" id='txtSortOrderSubCategory' />

                                    </div>
                                </div>
                            </div>
                            <button type="button" id="SubmitSubCategory" class="btn btn-primary">Submit</button>

                        </form>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="panel panel-default">
                    <div class="panel-heading">Detail</div>
                    <div class="panel-body prd-tbl">
                        <div class="tbl-container tbl-product">
                            <!-- Table -->
                            <table class="table" id="SubCategory_table">
                                <thead class="thead-dark">
                                    <tr>
                                        <th>Category</th>
                                        <th>Sub-Category</th>
                                        <th>Short Code</th>
                                        <th>Sort Order</th>
                                      
                                        @*<th class="text-right" scope="col">Action</th>*@
                                    </tr>
                                </thead>
                                <tbody>
                                  
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
